/* ================= PAGE SWITCH ================= */

function hideAllPages() {

    document
        .getElementById("registerPage")
        .classList.add("hidden");

    document
        .getElementById("successPage")
        .classList.add("hidden");

    document
        .getElementById("loginPage")
        .classList.add("hidden");
}


/* ================= REGISTER ================= */

function registerUser() {

    const phone =
        document
            .getElementById("phone")
            .value
            .trim();

    const password =
        document
            .getElementById("password")
            .value
            .trim();


    /* Check empty fields */

    if (phone === "" || password === "") {

        alert(
            "Please enter your number and password."
        );

        return;
    }


    /* Check phone number */

    if (!/^[6-9][0-9]{9}$/.test(phone)) {

        alert(
            "Please enter a valid 10-digit phone number."
        );

        return;
    }


    /*
       ONLY AFTER SUCCESSFUL REGISTRATION
       THE SUCCESS PAGE WILL OPEN.
    */

    hideAllPages();

    document
        .getElementById("successPage")
        .classList.remove("hidden");
}


/* ================= OPEN LOGIN ================= */

function openLogin() {

    hideAllPages();

    document
        .getElementById("loginPage")
        .classList.remove("hidden");
}


/* ================= OPEN REGISTER ================= */

function openRegister() {

    hideAllPages();

    document
        .getElementById("registerPage")
        .classList.remove("hidden");
}


/* ================= LOGIN ================= */

function loginUser() {

    const phone =
        document
            .getElementById("loginPhone")
            .value
            .trim();

    const password =
        document
            .getElementById("loginPassword")
            .value
            .trim();


    if (phone === "" || password === "") {

        alert(
            "Please enter your number and password."
        );

        return;
    }


    if (!/^[6-9][0-9]{9}$/.test(phone)) {

        alert(
            "Please enter a valid 10-digit phone number."
        );

        return;
    }


    alert("Login successful!");
}
